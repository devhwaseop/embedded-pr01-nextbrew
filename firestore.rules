rules_version = '2';

// NextBrew Firestore 보안 규칙
// 로그인한 사용자는 자기 데이터(users/{자기 uid}/…)만 읽고 쓸 수 있다. 그 밖은 모두 거절.
// Firebase 콘솔 → Firestore Database → 규칙 탭에 이 내용을 붙여넣고 게시한다.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
